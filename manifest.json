{
  "manifest_version": 3,
  "name": "Desktop GIFs",
  "version": "0.1.8",
  "description": "Post Tenor GIFs in YouTube comments and replies from desktop.",
  "browser_specific_settings": {
    "gecko": {
      "id": "desktop-gifs@rayytor",
      "strict_min_version": "140.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://tenor.com*", "https://www.youtube.com/*"],
  "background": {
    "scripts": ["src/sw.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ]
}
